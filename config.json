{
  # Highscore file (created automatically if missing)
  "highscore_filename": "highscores.json",

  # Seed used for the first level (next ones are random)
  "seed": 42,

  # Player starts with this many lives
  "lives": 3,

  # Time limit per level, in seconds
  "level_max_time": 90,

  # Scoring
  "points_per_pacgum": 10,
  "points_per_super_pacgum": 50,
  "points_per_ghost": 200,

  # Maze size for each level. If the player goes beyond
  # this list, the last entry is reused for the rest.
  "level": [
    { "width": 15, "height": 15 },
    { "width": 17, "height": 17 },
    { "width": 19, "height": 19 },
    { "width": 21, "height": 21 },
    { "width": 21, "height": 21 },
    { "width": 23, "height": 23 },
    { "width": 23, "height": 23 },
    { "width": 25, "height": 25 },
    { "width": 27, "height": 27 },
    { "width": 29, "height": 29 }
  ]
}
